# FinGuard Environment Configuration

# App Config
PROJECT_NAME="FinGuard Fraud Detection API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database
# For local development without PostgreSQL running, SQLite fallback is supported:
# DATABASE_URL="sqlite:///./finguard.db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finguard"

# Authentication & Security
SECRET_KEY="finguard-super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ML Model Config
MODEL_PATH="../ml/models/fraud_detector_v1.joblib"
RULE_WEIGHT=0.4
ML_WEIGHT=0.6

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
